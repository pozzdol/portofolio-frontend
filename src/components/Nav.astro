---
import { Icon } from "astro-icon/components";

const tabs = [
  { href: "/", label: "Projects" },
  { href: "/resume", label: "Resumé" },
  { href: "/certificates", label: "Certificates" },
];

// Trailing slashes vary by build config; normalise both sides before comparing.
const norm = (p: string) => p.replace(/\/+$/, "") || "/";
const here = norm(Astro.url.pathname);
---

<div
  class="border-theme-200 bg-theme-50/80 sticky top-0 z-1 w-full border-b px-4 pr-6 backdrop-blur-3xl md:px-8 lg:w-full lg:px-6"
>
  <!-- Three tabs plus four icons overflow a 320px viewport, so the icon row
       wraps to its own line on the narrowest screens instead of being clipped. -->
  <div class="flex flex-wrap items-center gap-x-3">
    <nav class="main-nav flex text-sm md:text-base" style="margin-bottom: -1px">
      {
        tabs.map((tab) => (
          <a
            href={tab.href}
            class:list={[
              "shrink-0 px-3 pt-5 pb-3 md:px-4",
              { active: here === norm(tab.href) },
            ]}
          >
            {tab.label}
          </a>
        ))
      }
    </nav>
    <nav
      class="ml-auto flex shrink-0 gap-3 pb-3 text-lg text-slate-400 md:gap-4 md:pb-0"
    >
      <a
        href="mailto:developer@fikriachmad.dev?subject=Hi%20from%20the%20internet"
        class="hover:text-theme-500"
        aria-label="email"><Icon name="tabler:at" /></a
      >
      <a
        href="https://github.com/imathis"
        class="hover:text-theme-500"
        target="_blank"
        aria-label="github"><Icon name="tabler:brand-github" /></a
      >
      <a
        href="https://x.com/imathis"
        class="hover:text-theme-500"
        target="_blank"
        aria-label="x.com"><Icon name="tabler:brand-x" /></a
      >
      <a
        href="https://www.linkedin.com/in/imathis/"
        class="hover:text-theme-500"
        target="_blank"
        aria-label="linked in"><Icon name="tabler:brand-linkedin" /></a
      >
    </nav>
  </div>
</div>
