---
import { Icon } from "astro-icon/components";
import type { Tech } from "../lib/portfolio";

interface Props {
  tech: Tech[];
  /** Project entries lay the chips out in a row; resume entries stack them. */
  layout?: "row" | "column";
}

const { tech, layout = "row" } = Astro.props;

const listClass =
  layout === "column"
    ? "flex flex-wrap gap-3 gap-y-2 @xl:flex-col"
    : "flex flex-wrap gap-x-4 gap-y-1.5";
---

<ul class={listClass}>
  {
    tech.map((item) => (
      <li class="spec inline-flex items-center gap-1.5 self-start text-slate-600">
        {item.icon && (
          <Icon name={item.icon} class="text-theme-500 shrink-0 text-sm" />
        )}
        <span>{item.label}</span>
      </li>
    ))
  }
</ul>
