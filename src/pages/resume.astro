---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import TechList from "../components/TechList.astro";
import { getExperiences, period } from "../lib/portfolio";
import { site } from "../config/site";

const experiences = await getExperiences();

const iso = (d: Date) => d.toISOString().slice(0, 10);

const resumeLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${site.url}/resume#profile`,
  mainEntity: {
    "@id": `${site.url}/#person`,
    "@type": "Person",
    name: site.name,
    hasOccupation: experiences.map((job) => ({
      "@type": "OrganizationRole",
      roleName: job.role,
      startDate: iso(job.started_on),
      ...(job.ended_on && { endDate: iso(job.ended_on) }),
      ...(job.highlights.length > 0 && {
        description: job.highlights.join(" "),
      }),
      memberOf: {
        "@type": "Organization",
        name: job.company,
        ...(job.company_url && { url: job.company_url }),
      },
    })),
  },
};
---

<Layout
  title="Resumé | Fikri Achmad"
  description="Professional experience of Fikri Achmad: building internal web applications in Laravel, Inertia and React on PostgreSQL, OAuth2 and RBAC, legacy migration, Ubuntu and Nginx deployment, CI/CD, and IoT."
  noindex={experiences.length === 0}
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(resumeLd)}
  />

  <div
    class="@container grid max-w-4xl gap-y-5 py-10 @md:gap-y-10 @md:py-15 @lg:py-20"
  >
    <div class="px-8 md:px-10">
      <h1 class="text-3xl/9 font-bold">
        Experience — Fullstack Web Development &amp; Business Integration
      </h1>
      <p class="mt-3 text-slate-600">
        Roles, what I owned in them, and what changed because of the work.
      </p>
    </div>

    <h2 class="sr-only">Professional experience</h2>

    {
      experiences.length === 0 && (
        <div class="px-8 py-16 md:px-10">
          <p class="text-lg font-semibold">
            Experience is being written up properly.
          </p>
          <p class="mt-2 text-slate-600">
            An empty page is more honest than a half-filled one. In the meantime
            the work itself is on the projects page, and the code is on GitHub.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href="/" class="btn btn-primary">
              See the projects
            </a>
            <a
              href={site.github}
              rel="me noopener noreferrer"
              target="_blank"
              class="btn btn-secondary"
            >
              GitHub
              <span class="sr-only">(opens in a new tab)</span>
            </a>
          </div>
        </div>
      )
    }

    {
      experiences.map((job, i) => (
        <>
          {i > 0 && <hr class="border-theme-200 my-5 lg:ml-17" />}
          <article class="@container reveal-scroll">
            <div class="flex flex-col gap-7 px-8 @xl:grid @xl:grid-cols-[1fr_auto] @xl:gap-12 @xl:px-10 @xl:pl-17">
              <div class="flex flex-col gap-7">
                <div class="relative grid gap-1">
                  <Icon
                    name="tabler:shield-star"
                    class="text-theme-500 invisible absolute -left-10 h-8 w-8 @xl:visible"
                    aria-hidden="true"
                    focusable="false"
                  />
                  <h3 class="text-2xl/7 font-bold">{job.role}</h3>
                  <div class="flex flex-row flex-wrap items-baseline gap-2">
                    <div class="text-base font-normal">
                      {job.company_url ? (
                        <a
                          href={job.company_url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-theme-900 hover:text-theme-500"
                        >
                          {job.company}
                          <span class="sr-only">(opens in a new tab)</span>
                        </a>
                      ) : (
                        job.company
                      )}
                    </div>
                    {/* Was opacity-50: 3.12:1, an AA failure on the one field a
                        reader with low vision needs most. slate-500 is 4.77:1. */}
                    <div class="text-sm text-slate-500">
                      <time datetime={iso(job.started_on)}>
                        {period(job.started_on, job.ended_on)}
                      </time>
                    </div>
                  </div>
                </div>
                {job.highlights.length > 0 && (
                  <ul class="space-y-3">
                    {job.highlights.map((point) => (
                      <li class="flex items-start space-x-3 text-base/tight text-slate-700">
                        <Icon
                          name="tabler:circle-check"
                          class="h-text w-text text-confirm shrink-0 self-start"
                          aria-hidden="true"
                          focusable="false"
                        />
                        <span>{point}</span>
                      </li>
                    ))}
                  </ul>
                )}
                {job.blurb && (
                  <p class="border-theme-200 bg-theme-50 shadow-theme-200 rounded-md border px-5 py-3 text-sm text-slate-600 italic shadow-md">
                    {job.blurb}
                  </p>
                )}
              </div>
              <TechList tech={job.tech} layout="column" />
            </div>
          </article>
        </>
      ))
    }
  </div>
</Layout>
