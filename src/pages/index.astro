---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Sidebar from "../components/Sidebar.astro";
import TechList from "../components/TechList.astro";
import { getProjects } from "../lib/portfolio";

const projects = await getProjects();
---

<Layout title="Projects - Portfolio">
  <div class="lg:grid lg:grid-cols-12">
    <Sidebar />
    <main
      class="border-theme-200 bg-theme-100 col-span-8 col-start-5 lg:min-h-dvh lg:border-l"
    >
      <Nav />
      <div
        class="@container grid gap-y-5 py-10 lg:max-w-4xl @md:gap-y-10 @md:py-15 @lg:py-20"
      >
        {
          projects.map((project, i) => (
            <>
              {i > 0 && <hr class="border-theme-200 my-5 @xl:ml-10" />}
              <div class="@container reveal-scroll">
                <div class="flex flex-col gap-7 px-8 md:px-10">
                  <div class="grid gap-2">
                    <a
                      class="hover:text-theme-600 flex items-center gap-2"
                      target="_blank"
                      href={project.live_url ?? project.repo_url ?? undefined}
                    >
                      <h3 class="text-2xl/7 font-bold">{project.title}</h3>
                      {(project.live_url || project.repo_url) && (
                        <Icon name="tabler:external-link" class="mt-1 size-3" />
                      )}
                    </a>
                    <div class="flex items-baseline justify-between gap-2">
                      <TechList tech={project.tech} />
                      {project.live_url && (
                        <a
                          href={project.live_url}
                          title="live site"
                          target="_blank"
                          class="hover:text-theme-500 spec flex shrink-0 items-center gap-1 text-slate-600"
                        >
                          <Icon name="tabler:world" />
                          Live
                        </a>
                      )}
                      {project.repo_url && (
                        <a
                          href={project.repo_url}
                          title="source"
                          target="_blank"
                          class="hover:text-theme-500 spec flex shrink-0 items-center gap-1 text-slate-600"
                        >
                          <Icon name="tabler:brand-github" />
                          Source
                        </a>
                      )}
                    </div>
                  </div>
                  {project.image && (
                    <a
                      class="shot shadow-theme-200 shadow-md"
                      target="_blank"
                      href={project.live_url ?? project.image.src}
                    >
                      <img
                        src={project.image.src}
                        alt={project.image.alt}
                        loading="lazy"
                        decoding="async"
                        width={project.image.width ?? undefined}
                        height={project.image.height ?? undefined}
                      />
                    </a>
                  )}
                  <div class="text-slate-600">
                    <p>{project.summary}</p>
                  </div>
                </div>
              </div>
            </>
          ))
        }
        <hr class="border-theme-200 my-5 @xl:ml-10" />

        <footer
          class="colophon bg-theme-100 px-14 py-8 text-center text-slate-500 lg:text-left"
        >
          © <span class="dynamic-year">2026</span> Fikri Achmad. All rights reserved.
        </footer>
        <script>
          document.addEventListener("DOMContentLoaded", () => {
            const yearElement = document.querySelector(".dynamic-year");
            if (yearElement) {
              yearElement.textContent = new Date().getFullYear().toString();
            }
          });
        </script>
      </div>
    </main>
  </div>
</Layout>
