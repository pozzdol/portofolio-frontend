---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import TechList from "../components/TechList.astro";
import { getProjects } from "../lib/portfolio";
import { site } from "../config/site";

const projects = await getProjects();

const projectsLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${site.url}/#projects`,
  name: `Projects by ${site.name}`,
  about: { "@id": `${site.url}/#person` },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: projects.map((project, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "SoftwareSourceCode",
        name: project.title,
        description: project.summary,
        ...(project.live_url && { url: project.live_url }),
        ...(project.repo_url && { codeRepository: project.repo_url }),
        ...(project.image && { image: project.image.src }),
        programmingLanguage: project.tech.map((t) => t.label),
        author: { "@id": `${site.url}/#person` },
      },
    })),
  },
};
---

<Layout
  title="Fikri Achmad — Fullstack Web Developer (Laravel, React, PostgreSQL)"
  description="Fullstack web developer in Indonesia. I build web applications end to end in Laravel, Inertia and React on PostgreSQL, and run them myself on Ubuntu with Nginx, Docker and CI/CD."
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(projectsLd)}
  />

  <div
    class="@container grid gap-y-5 py-10 lg:max-w-4xl @md:gap-y-10 @md:py-15 @lg:py-20"
  >
    <div class="px-8 md:px-10">
      <h1 class="text-3xl/9 font-bold">
        Fullstack web projects — Laravel, React, PostgreSQL
      </h1>
      <p class="mt-3 text-slate-600">
        Production work and side builds. Each entry names the problem, the
        stack, and what changed after it shipped.
      </p>
    </div>

    <h2 class="sr-only">Selected projects</h2>

    {
      projects.length === 0 && (
        <div class="px-8 py-16 md:px-10">
          <p class="text-lg font-semibold">Case studies are being written up.</p>
          <p class="mt-2 text-slate-600">The code is public in the meantime.</p>
          <a
            href={site.github}
            rel="me noopener noreferrer"
            target="_blank"
            class="btn btn-primary mt-6"
          >
            Browse the repositories
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        </div>
      )
    }

    {
      projects.map((project, i) => {
        const href = project.live_url ?? project.repo_url;
        return (
          <>
            {i > 0 && <hr class="border-theme-200 my-5 @xl:ml-10" />}
            <article class="@container reveal-scroll">
              <div class="flex flex-col gap-7 px-8 md:px-10">
                <div class="grid gap-2">
                  {/* Without an href this used to render an <a> with no link
                      role: hover-coloured, unfocusable, not announced. */}
                  {href ? (
                    <a
                      class="hover:text-theme-600 flex items-center gap-2"
                      target="_blank"
                      rel="noopener noreferrer"
                      href={href}
                    >
                      <h3 class="text-2xl/7 font-bold">{project.title}</h3>
                      <Icon
                        name="tabler:external-link"
                        class="mt-1 size-3"
                        aria-hidden="true"
                        focusable="false"
                      />
                      <span class="sr-only">(opens in a new tab)</span>
                    </a>
                  ) : (
                    <h3 class="text-2xl/7 font-bold">{project.title}</h3>
                  )}

                  <div class="flex items-baseline justify-between gap-2">
                    <TechList tech={project.tech} />
                    {project.live_url && (
                      <a
                        href={project.live_url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hover:text-theme-500 spec flex shrink-0 items-center gap-1 text-slate-600"
                      >
                        <Icon
                          name="tabler:world"
                          aria-hidden="true"
                          focusable="false"
                        />
                        Live
                        {/* "Live"/"Source" repeat on every card; a screen-reader
                            link list needs to tell them apart. */}
                        <span class="sr-only">
                          site for {project.title} (opens in a new tab)
                        </span>
                      </a>
                    )}
                    {project.repo_url && (
                      <a
                        href={project.repo_url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hover:text-theme-500 spec flex shrink-0 items-center gap-1 text-slate-600"
                      >
                        <Icon
                          name="tabler:brand-github"
                          aria-hidden="true"
                          focusable="false"
                        />
                        Source
                        <span class="sr-only">
                          code for {project.title} (opens in a new tab)
                        </span>
                      </a>
                    )}
                  </div>
                </div>

                {/* The first screenshot is the LCP element on desktop, so it
                    loads eagerly at high priority; lazy-loading it deferred the
                    request until after layout, which is pure LCP cost. */}
                {project.image &&
                  (project.live_url ? (
                    <a
                      class="shot shadow-theme-200 shadow-md"
                      target="_blank"
                      rel="noopener noreferrer"
                      href={project.live_url}
                    >
                      <img
                        src={project.image.src}
                        alt={project.image.alt}
                        loading={i === 0 ? "eager" : "lazy"}
                        fetchpriority={i === 0 ? "high" : "auto"}
                        decoding="async"
                        width={project.image.width ?? undefined}
                        height={project.image.height ?? undefined}
                      />
                      <span class="sr-only">
                        Screenshot of {project.title} — visit the live site
                        (opens in a new tab)
                      </span>
                    </a>
                  ) : (
                    /* No live URL: the old fallback linked to the raw .webp on
                       the CDN, which is a dead end in a new tab. */
                    <div class="shot shadow-theme-200 shadow-md">
                      <img
                        src={project.image.src}
                        alt={project.image.alt}
                        loading={i === 0 ? "eager" : "lazy"}
                        fetchpriority={i === 0 ? "high" : "auto"}
                        decoding="async"
                        width={project.image.width ?? undefined}
                        height={project.image.height ?? undefined}
                      />
                    </div>
                  ))}

                <div class="text-slate-600">
                  <p>{project.summary}</p>
                </div>
              </div>
            </article>
          </>
        );
      })
    }
  </div>
</Layout>
