---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import TechList from "../components/TechList.astro";
import { getCertificates, year } from "../lib/portfolio";
import { site } from "../config/site";

const certificates = await getCertificates();

const iso = (d: Date) => d.toISOString().slice(0, 10);

const certsLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${site.url}/certificates#credentials`,
  itemListElement: certificates.map((cert, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "EducationalOccupationalCredential",
      name: cert.title,
      ...(cert.note && { description: cert.note }),
      credentialCategory: "certificate",
      dateCreated: iso(cert.issued_on),
      ...(cert.expires_on && { expires: iso(cert.expires_on) }),
      ...(cert.credential_id && { identifier: cert.credential_id }),
      ...(cert.credential_url && { url: cert.credential_url }),
      recognizedBy: {
        "@type": "Organization",
        name: cert.issuer,
        ...(cert.issuer_url && { url: cert.issuer_url }),
      },
      about: cert.tech.map((t) => t.label),
      credentialSubject: { "@id": `${site.url}/#person` },
    },
  })),
};
---

<Layout
  title="Certifications - Fikri Achmad | Verified Credentials"
  description="Verified professional certifications held by Fikri Achmad, fullstack web developer — each with issuer, credential ID, and a public verification link."
  noindex={certificates.length === 0}
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(certsLd)}
  />

  <div
    class="@container grid max-w-4xl gap-y-5 py-10 @md:gap-y-10 @md:py-15 @lg:py-20"
  >
    <div class="px-8 md:px-10">
      <h1 class="text-3xl/9 font-bold">
        Certifications &amp; verified credentials
      </h1>
      <p class="mt-3 text-slate-600">
        Every entry carries its issuer, credential ID, and a public verification
        link — a certificate you cannot check is not evidence.
      </p>
    </div>

    <h2 class="sr-only">Professional certifications</h2>

    {
      certificates.length === 0 && (
        <div class="px-8 py-16 md:px-10">
          <p class="text-lg font-semibold">No certifications published yet.</p>
          <p class="mt-2 text-slate-600">
            This page lists only credentials with a working verification link.
            Until there are some, the work on the projects page is the evidence.
          </p>
          <a href="/" class="btn btn-primary mt-6">
            See the projects
          </a>
        </div>
      )
    }

    {
      certificates.map((cert, i) => (
        <>
          {i > 0 && <hr class="border-theme-200 my-5 lg:ml-17" />}
          <article class="@container reveal-scroll">
            <div class="flex flex-col gap-7 px-8 @xl:grid @xl:grid-cols-[1fr_auto] @xl:gap-12 @xl:px-10 @xl:pl-17">
              <div class="flex flex-col gap-7">
                <div class="relative grid gap-1">
                  <Icon
                    name="tabler:certificate"
                    class="text-theme-500 invisible absolute -left-10 h-8 w-8 @xl:visible"
                    aria-hidden="true"
                    focusable="false"
                  />
                  <h3 class="text-2xl/7 font-bold">{cert.title}</h3>
                  <div class="flex flex-row flex-wrap items-baseline gap-2">
                    <div class="text-base font-normal">
                      {cert.issuer_url ? (
                        <a
                          href={cert.issuer_url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-theme-900 hover:text-theme-500"
                        >
                          {cert.issuer}
                          <span class="sr-only">(opens in a new tab)</span>
                        </a>
                      ) : (
                        cert.issuer
                      )}
                    </div>
                    <div class="text-sm text-slate-500">
                      <time datetime={iso(cert.issued_on)}>
                        {year(cert.issued_on)}
                      </time>
                      {cert.expires_on && (
                        <>
                          {" - expires "}
                          <time datetime={iso(cert.expires_on)}>
                            {year(cert.expires_on)}
                          </time>
                        </>
                      )}
                    </div>
                  </div>
                </div>
                <ul class="space-y-3">
                  {cert.credential_id && (
                    <li class="flex items-start space-x-3 text-base/tight text-slate-700">
                      <Icon
                        name="tabler:id"
                        class="h-text w-text text-confirm shrink-0 self-start"
                        aria-hidden="true"
                        focusable="false"
                      />
                      <span>
                        Credential ID{" "}
                        <span class="colophon">{cert.credential_id}</span>
                      </span>
                    </li>
                  )}
                  {cert.credential_url && (
                    <li class="flex items-start space-x-3 text-base/tight text-slate-700">
                      <Icon
                        name="tabler:circle-check"
                        class="h-text w-text text-confirm shrink-0 self-start"
                        aria-hidden="true"
                        focusable="false"
                      />
                      <a
                        href={cert.credential_url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-theme-500 hover:text-theme-600 decoration-theme-300 underline decoration-1 underline-offset-4"
                      >
                        Verify this credential
                        <span class="sr-only">
                          — {cert.title} from {cert.issuer} (opens in a new tab)
                        </span>
                      </a>
                    </li>
                  )}
                </ul>
                {cert.note && (
                  <p class="border-theme-200 bg-theme-50 shadow-theme-200 rounded-md border px-5 py-3 text-sm text-slate-600 italic shadow-md">
                    {cert.note}
                  </p>
                )}
                {cert.image && (
                  <a
                    class="shot shadow-theme-200 max-w-md shadow-md"
                    href={cert.image.src}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <img
                      src={cert.image.src}
                      alt={cert.image.alt}
                      loading="lazy"
                      decoding="async"
                      width={cert.image.width ?? undefined}
                      height={cert.image.height ?? undefined}
                    />
                    <span class="sr-only">
                      View the full-size {cert.title} certificate (opens in a
                      new tab)
                    </span>
                  </a>
                )}
              </div>
              <TechList tech={cert.tech} layout="column" />
            </div>
          </article>
        </>
      ))
    }
  </div>
</Layout>
