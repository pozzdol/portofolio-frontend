# Read-only Postgres role — this build only ever runs SELECT.
# Create the role in the admin panel's database:
#
#   create role portfolio_reader login password '...';
#   grant connect on database <db> to portfolio_reader;
#   grant usage on schema public to portfolio_reader;
#   grant select on all tables in schema public to portfolio_reader;
#   alter default privileges in schema public grant select on tables to portfolio_reader;
#
# Copy this file to .env for local builds; add the same value as a CI secret.
DATABASE_URL=postgres://portfolio_reader:password@host:5432/portfolio?sslmode=require
